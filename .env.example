# TungTung Restaurant — Environment Variables
# Copy this to .env for local development

# Server binding
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# PUBLIC_URL — Cloud deployment external domain
# Leave empty for local development (server auto-detects LAN IP).
# Set to your Render/Railway/Fly.io domain for production:
#   e.g.  PUBLIC_URL=https://tungtung-restaurant.onrender.com
# This is used by the Host QR Code to generate scannable links
# for mobile players on external Wi-Fi / mobile networks.
PUBLIC_URL=

# Project metadata
PROJECT_NAME="TungTung Restaurant"
OWNER_EMAIL=nananashop19911@gmail.com
